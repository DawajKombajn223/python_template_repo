[MASTER]
ignore=__pycache__,build,dist,venv,.venv
jobs=1

[FORMAT]
max-line-length=88

[MESSAGES CONTROL]
# Disable only docstring warnings by default to reduce noise in small scripts
disable=C0114,C0115,C0116

[REPORTS]
output-format = colorized

[LOGGING]
# Allow basic logging calling styles
logging-modules=logging
